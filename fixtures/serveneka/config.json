            "interfaces": [
                {"ip4":"0.0.0.0", "port": 8080, "proto":"http"},
                {"ip4":"0.0.0.0", "port": 8443, "proto":"https"},
                {"ip6":"::", "port": 8080, "proto":"http"},
                {"ip6":"::", "port": 8443, "proto":"https"}
